    function engineAmortizedLoan(params) {
      const price = parseFloat(params.price) || 0;
      const down = parseFloat(params.down) || 0;
      const tradeIn = parseFloat(params.tradeIn) || 0;
      const payoff = parseFloat(params.payoff) || 0;
      const taxPct = parseFloat(params.taxPct) || 0;
      const fees = parseFloat(params.fees) || 0;
      const apr = parseFloat(params.apr) || 0;
      const termVal = parseFloat(params.term) || 60;
      const termUnit = params.termUnit || 'months';
      const frequency = params.frequency || 'monthly';
      const residual = parseFloat(params.residual) || 0;

      const taxAmount = price * (taxPct / 100);
      const netTradeIn = tradeIn - payoff;
      const amountFinanced = Math.max(0, price + taxAmount + fees - down - netTradeIn);

      let freqPerYear = 12;
      if (frequency === 'biweekly') freqPerYear = 26;
      if (frequency === 'weekly') freqPerYear = 52;

      const totalMonths = termUnit === 'years' ? termVal * 12 : termVal;
      const totalPeriods = Math.round((totalMonths / 12) * freqPerYear);

      const r = (apr / 100) / freqPerYear;
      const residualPV = residual > 0 && totalPeriods > 0 ? residual / Math.pow(1 + r, totalPeriods) : 0;
      const amortizablePrincipal = Math.max(0, amountFinanced - residualPV);

      let pmt = 0;
      if (totalPeriods > 0) {
        pmt = r === 0 ? amortizablePrincipal / totalPeriods : (amortizablePrincipal * r) / (1 - Math.pow(1 + r, -totalPeriods));
      }

      const totalPayments = pmt * totalPeriods + residual;
      const totalInterest = Math.max(0, totalPayments - amountFinanced);
      const totalCost = price + taxAmount + fees + totalInterest;

      let balance = amountFinanced;
      const schedule = [];
      for (let i = 1; i <= totalPeriods; i++) {
        const interestForPeriod = balance * r;
        let principalForPeriod = pmt - interestForPeriod;
        if (i === totalPeriods && residual === 0) principalForPeriod = balance;
        balance = Math.max(0, balance - principalForPeriod);
        schedule.push({ period: i, payment: pmt, interest: interestForPeriod, principal: principalForPeriod, balance: balance });
      }

      return { amountFinanced, pmt, totalInterest, totalCost, schedule };
    }

    function engineSellerFinancing(params) {
      const price = parseFloat(params.price) || 300000;
      const down = parseFloat(params.down) || 60000;
      const rate = parseFloat(params.rate) || 6.5;
      const amortYears = parseFloat(params.amortYears) || 30;
      const balloonYears = parseFloat(params.balloonYears) || 5;

      const loanAmt = Math.max(0, price - down);
      const r = (rate / 100) / 12;
      const totalAmortMonths = amortYears * 12;
      const balloonMonths = balloonYears * 12;

      const pmt = r === 0 ? loanAmt / totalAmortMonths : (loanAmt * r) / (1 - Math.pow(1 + r, -totalAmortMonths));
      let balance = loanAmt;
      const schedule = [];

      for (let i = 1; i <= balloonMonths; i++) {
        const interest = balance * r;
        const principal = pmt - interest;
        balance = Math.max(0, balance - principal);
        schedule.push({ period: i, payment: pmt, interest, principal, balance });
      }

      const balloonBalance = schedule[balloonMonths - 1] ? schedule[balloonMonths - 1].balance : 0;
      const totalInterest = (pmt * balloonMonths + balloonBalance) - loanAmt;

      return { amountFinanced: loanAmt, pmt, totalInterest, totalCost: balloonBalance, schedule };
    }

    function engineReverseMortgage(params) {
      const homeValue = parseFloat(params.homeValue) || 400000;
      const age = parseFloat(params.age) || 68;
      const rate = parseFloat(params.rate) || 6.0;
      const limit = parseFloat(params.limit) || 1149825;
      const existingMortgage = parseFloat(params.existingMortgage) || 50000;

      const maxEligible = Math.min(homeValue, limit);
      let plf = Math.max(0.15, Math.min(0.75, 0.35 + (age - 62) * 0.012 - (rate - 5.0) * 0.03));
      const grossLimit = maxEligible * plf;
      const netProceeds = Math.max(0, grossLimit - existingMortgage);
      const monthlyPayout = netProceeds / (Math.max(5, 95 - age) * 12);

      return { amountFinanced: grossLimit, pmt: monthlyPayout, totalInterest: netProceeds, totalCost: homeValue, schedule: [] };
    }

    function engineFinanceCharge(params) {
      const amount = parseFloat(params.amount) || 100000;
      const rate = parseFloat(params.rate) || 6.5;
      const termYears = parseFloat(params.termYears) || 15;
      const points = parseFloat(params.points) || 1.0;
      const fees = parseFloat(params.fees) || 1500;

      const totalPrepaid = amount * (points / 100) + fees;
      const netProceeds = amount - totalPrepaid;
      const months = termYears * 12;
      const r = (rate / 100) / 12;
      const pmt = r === 0 ? amount / months : (amount * r) / (1 - Math.pow(1 + r, -months));

      let minRate = 0, maxRate = 0.5;
      for (let i = 0; i < 40; i++) {
        const testR = ((minRate + maxRate) / 2) / 12;
        const pv = testR === 0 ? pmt * months : pmt * (1 - Math.pow(1 + testR, -months)) / testR;
        if (pv > netProceeds) minRate = (minRate + maxRate) / 2; else maxRate = (minRate + maxRate) / 2;
      }
      const apr = ((minRate + maxRate) / 2) * 100;

      return { amountFinanced: netProceeds, pmt, totalInterest: (pmt * months) - netProceeds, totalCost: apr, schedule: [] };
    }

    function engineInvoiceFinance(params) {
      const val = parseFloat(params.invoiceVal) || 50000;
      const adv = parseFloat(params.advanceRate) || 85;
      const fee = parseFloat(params.factoringFee) || 2.5;
      const days = parseFloat(params.daysToPay) || 45;

      const cash = val * (adv / 100);
      const totalFee = val * (fee / 100);
      const rebate = val - cash - totalFee;
      const eac = (totalFee / cash) * (365 / days) * 100;

      return { amountFinanced: cash, pmt: rebate, totalInterest: totalFee, totalCost: eac, schedule: [] };
    }

    function engineZakat(params) {
      const cash = parseFloat(params.cash) || 0;
      const gold = parseFloat(params.goldGrams) || 0;
      const silver = parseFloat(params.silverGrams) || 0;
      const inv = parseFloat(params.investments) || 0;
      const liab = parseFloat(params.liabilities) || 0;

      const total = cash + (gold * 75) + (silver * 0.85) + inv;
      const net = Math.max(0, total - liab);
      const nisab = 612.36 * 0.85;
      const zakat = net >= nisab ? net * 0.025 : 0;

      return { amountFinanced: net, pmt: zakat, totalInterest: nisab, totalCost: total, schedule: [] };
    }

