    function bindToolEvents(tool) {
      document.querySelectorAll('#inputs-box input').forEach(inp => {
        inp.addEventListener('input', () => {
          if (inp.id.startsWith('inp-')) {
            const sl = document.getElementById(inp.id.replace('inp-', 'slider-'));
            if (sl) sl.value = inp.value;
          }
          if (inp.id.startsWith('slider-')) {
            const bx = document.getElementById(inp.id.replace('slider-', 'inp-'));
            if (bx) bx.value = inp.value;
          }
          clearTimeout(state.debouncedTimer);
          state.debouncedTimer = setTimeout(() => recalculateTool(tool), 80);
        });
      });

      document.getElementById('reset-btn').addEventListener('click', () => renderToolPageView(document.getElementById('app-root'), tool.slug));
      document.getElementById('dl-pdf-btn').addEventListener('click', () => downloadPDF(tool));
      document.getElementById('dl-csv-btn').addEventListener('click', () => downloadCSV(tool));
      document.getElementById('share-btn').addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        alert('Share link copied to clipboard!');
      });
    }

    function collectInputs() {
      const data = {};
      document.querySelectorAll('#inputs-box input').forEach(i => {
        if (i.id.startsWith('inp-')) data[i.id.replace('inp-', '')] = i.value;
      });
      return data;
    }

    function recalculateTool(tool) {
      const inputs = collectInputs();
      let res;
      if (tool.engine === 'zakat') res = engineZakat(inputs);
      else if (tool.engine === 'seller_financing') res = engineSellerFinancing(inputs);
      else if (tool.engine === 'reverse_mortgage') res = engineReverseMortgage(inputs);
      else if (tool.engine === 'finance_charge') res = engineFinanceCharge(inputs);
      else if (tool.engine === 'invoice_finance') res = engineInvoiceFinance(inputs);
      else res = engineAmortizedLoan(inputs);

      document.getElementById('res-pmt').textContent = formatCurrency(res.pmt);
      document.getElementById('res-interest').textContent = formatCurrency(res.totalInterest);
      document.getElementById('res-principal').textContent = formatCurrency(res.amountFinanced);
      document.getElementById('res-total').textContent = formatCurrency(res.totalCost);

      renderCharts(res);
      renderTable(res.schedule);
    }

    function renderCharts(res) {
      const donutCtx = document.getElementById('donut-canvas').getContext('2d');
      if (state.donutChart) state.donutChart.destroy();
      state.donutChart = new Chart(donutCtx, {
        type: 'doughnut',
        data: {
          labels: ['Principal', 'Interest'],
          datasets: [{ data: [res.amountFinanced, res.totalInterest], backgroundColor: ['#6366f1', '#fbbf24'] }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      const lineCtx = document.getElementById('line-canvas').getContext('2d');
      if (state.lineChart) state.lineChart.destroy();
      const points = (res.schedule || []).filter((_, i) => i % 6 === 0);
      state.lineChart = new Chart(lineCtx, {
        type: 'line',
        data: {
          labels: points.map(p => `P${p.period}`),
          datasets: [{ label: 'Remaining Balance', data: points.map(p => p.balance), borderColor: '#34d399', fill: false }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    }

    function renderTable(schedule) {
      const tbody = document.getElementById('schedule-tbody');
      if (!tbody || !schedule) return;
      tbody.innerHTML = schedule.slice(0, 48).map(r => `
        <tr>
          <td>${r.period}</td>
          <td>${formatCurrency(r.payment)}</td>
          <td>${formatCurrency(r.principal)}</td>
          <td>${formatCurrency(r.interest)}</td>
          <td>${formatCurrency(r.balance)}</td>
        </tr>
      `).join('');
    }

    function downloadCSV(tool) {
      const inputs = collectInputs();
      const res = engineAmortizedLoan(inputs);
      let csv = 'Period,Payment,Principal,Interest,Balance\n';
      (res.schedule || []).forEach(r => { csv += `${r.period},${r.payment.toFixed(2)},${r.principal.toFixed(2)},${r.interest.toFixed(2)},${r.balance.toFixed(2)}\n`; });
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${tool.slug}-schedule.csv`;
      a.click();
    }

    function downloadPDF(tool) {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      doc.setFontSize(18);
      doc.text(tool.title, 14, 20);
      doc.setFontSize(11);
      doc.text(`Estimated Payment: ${document.getElementById('res-pmt').textContent}`, 14, 32);
      doc.text(`Total Interest: ${document.getElementById('res-interest').textContent}`, 14, 40);
      doc.text(`Amount Financed: ${document.getElementById('res-principal').textContent}`, 14, 48);
      doc.save(`${tool.slug}-report.pdf`);
    }

