  <script>
    document.getElementById('year-span').textContent = new Date().getFullYear();

    /* ==========================================================================
       GLOBAL STATE & CURRENCY CONVERSION
       ========================================================================== */
    const state = {
      currency: 'USD',
      theme: localStorage.getItem('fin_theme') || 'system',
      activeTool: null,
      donutChart: null,
      lineChart: null,
      debouncedTimer: null,
      docItems: [{ desc: 'Financial Consulting & Advisory Services', qty: 1, rate: 1500 }]
    };

    const currencyData = {
      USD: { symbol: '$', rate: 1.0, locale: 'en-US' },
      CAD: { symbol: 'CA$', rate: 1.35, locale: 'en-US' },
      GBP: { symbol: '£', rate: 0.79, locale: 'en-GB' },
      INR: { symbol: '₹', rate: 83.5, locale: 'en-IN' }
    };

    const currencySelect = document.getElementById('currency-select');
    const mobileCurrencySelect = document.getElementById('mobile-currency-select');

    try {
      const savedCurr = localStorage.getItem('fin_currency');
      if (savedCurr && currencyData[savedCurr]) {
        state.currency = savedCurr;
        if (currencySelect) currencySelect.value = savedCurr;
        if (mobileCurrencySelect) mobileCurrencySelect.value = savedCurr;
      }
    } catch (e) {
      console.warn('localStorage disabled');
    }

    function setCurrency(val) {
      state.currency = val;
      if (currencySelect) currencySelect.value = val;
      if (mobileCurrencySelect) mobileCurrencySelect.value = val;
      try { localStorage.setItem('fin_currency', state.currency); } catch (e) {}
      updateCurrencyFigures();
      if (state.activeTool) recalculateTool(state.activeTool);
    }

    if (currencySelect) currencySelect.addEventListener('change', (e) => setCurrency(e.target.value));
    if (mobileCurrencySelect) mobileCurrencySelect.addEventListener('change', (e) => setCurrency(e.target.value));

    function updateCurrencyFigures() {
      const curr = currencyData[state.currency];
      document.querySelectorAll('.currency-symbol').forEach(el => el.textContent = curr.symbol);

      document.querySelectorAll('.count-up').forEach(el => {
        const baseTarget = parseFloat(el.getAttribute('data-target')) || 0;
        const decimals = parseInt(el.getAttribute('data-decimals')) || 0;
        const converted = baseTarget * curr.rate;
        el.textContent = new Intl.NumberFormat(curr.locale, { maximumFractionDigits: decimals, minimumFractionDigits: decimals }).format(converted);
      });
    }

    function formatCurrency(amt) {
      if (isNaN(amt) || !isFinite(amt)) return `${currencyData[state.currency].symbol}0`;
      const curr = currencyData[state.currency];
      return new Intl.NumberFormat(curr.locale, { style: 'currency', currency: state.currency, maximumFractionDigits: 2, minimumFractionDigits: 0 }).format(amt * curr.rate);
    }

    function formatNumber(num) {
      if (isNaN(num) || !isFinite(num)) return '0';
      const curr = currencyData[state.currency];
      return new Intl.NumberFormat(curr.locale, { maximumFractionDigits: 2 }).format(num * curr.rate);
    }

    // Theme Switcher
    const themeBtn = document.getElementById('theme-toggle');
    const mobileThemeBtn = document.getElementById('mobile-theme-toggle');

    function applyTheme(theme) {
      const label = theme === 'dark' ? '☀️ Light' : '🌙 Dark';
