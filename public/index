    function navigateTo(url) {
      history.pushState(null, '', url);
      router();
    }

    function router() {
      // Legacy Hash redirect to Clean HTML5 URL
      if (window.location.hash && window.location.hash.startsWith('#/')) {
        const cleanPath = window.location.hash.replace('#/', '/');
        history.replaceState(null, '', cleanPath);
      }

      let path = window.location.pathname || '/';
      if (path.length > 1 && path.endsWith('/')) {
        path = path.slice(0, -1);
      }

      const root = document.getElementById('app-root');
      if (!root) return;
      root.innerHTML = '';
      state.activeTool = null;

      if (path === '/' || path === '' || path === '/index.html') {
        renderHomepageView(root);
      } else if (path === '/calculators') {
        renderCalculatorsListView(root);
      } else if (path === '/generators') {
        renderGeneratorsListView(root);
      } else if (path.startsWith('/tool/')) {
        const slug = path.replace('/tool/', '').split('?')[0];
        renderToolPageView(root, slug);
      } else if (path.startsWith('/generator/')) {
        const slug = path.replace('/generator/', '');
        renderGeneratorPageView(root, slug);
      } else if (path === '/guides' || path.startsWith('/guides/')) {
        renderGuidesPageView(root, path.replace('/guides/', ''));
      } else if (path === '/faq') {
        renderFAQPageView(root);
      } else if (path === '/about') {
        renderInfoPageView(root, 'About FinancersLot', 'FinancersLot is a free, privacy-first platform providing over 60 financial calculators and document generators. All calculations execute 100% inside your browser using client-side JavaScript — no personal data or financial figures are ever sent to external servers.');
      } else if (path === '/privacy') {
        renderInfoPageView(root, 'Privacy Policy', 'Your privacy is guaranteed. FinancersLot does not collect, track, or store your loan balances, income figures, or document uploads. All calculations and PDF renderings occur locally in your browser session.');
      } else if (path === '/disclaimer') {
        renderInfoPageView(root, 'Financial Disclaimer', 'All calculation results, amortization tables, and document previews on FinancersLot are provided strictly for informational and educational purposes. FinancersLot is not a financial institution, lender, or registered tax advisor. Brand names are used solely for identification.');
      } else if (path === '/contact') {
        renderContactPageView(root);
      } else {
        renderHomepageView(root);
      }

      window.scrollTo(0, 0);
    }

    window.addEventListener('popstate', router);
    window.addEventListener('hashchange', router);

    document.addEventListener('click', (e) => {
      const anchor = e.target.closest('a');
      if (!anchor) return;
      const href = anchor.getAttribute('href');
      if (href && (href.startsWith('/') || href.startsWith('#/')) && !href.startsWith('//') && !anchor.getAttribute('target')) {
        e.preventDefault();
        const targetPath = href.startsWith('#/') ? href.replace('#/', '/') : href;
        history.pushState(null, '', targetPath);
        router();
      }
    });

