    function bindGeneratorEvents(gen, slug) {
      const itemsList = document.getElementById('line-items-list');

      function renderItemsUI() {
        if (!itemsList) return;
        itemsList.innerHTML = state.docItems.map((item, idx) => `
          <div class="flex items-center gap-2">
            <input type="text" class="form-input item-desc" data-idx="${idx}" value="${item.desc}" placeholder="Description" />
            <input type="number" class="form-input item-rate" data-idx="${idx}" value="${item.rate}" style="width: 110px;" />
          </div>
        `).join('');

        itemsList.querySelectorAll('.item-desc').forEach(i => i.addEventListener('input', e => {
          state.docItems[e.target.dataset.idx].desc = e.target.value;
          updatePreview();
        }));
        itemsList.querySelectorAll('.item-rate').forEach(i => i.addEventListener('input', e => {
          state.docItems[e.target.dataset.idx].rate = parseFloat(e.target.value) || 0;
          updatePreview();
        }));
      }

      function updatePreview() {
        if (slug === 'rent-receipt') {
          const tenant = document.getElementById('doc-tenant');
          const landlord = document.getElementById('doc-landlord');
          const address = document.getElementById('doc-address');
          const month = document.getElementById('doc-month');
          const pan = document.getElementById('doc-pan');

          if (tenant) document.getElementById('prev-tenant').textContent = tenant.value;
          if (landlord) document.getElementById('prev-landlord').textContent = landlord.value;
          if (address) document.getElementById('prev-address').textContent = address.value;
          if (month) document.getElementById('prev-month').textContent = month.value;
          if (pan) document.getElementById('prev-pan').textContent = pan.value;

          let total = 0;
          state.docItems.forEach(i => total += i.rate);
          document.getElementById('prev-total').textContent = formatCurrency(total);
        } else {
          const sender = document.getElementById('doc-sender');
          const client = document.getElementById('doc-client');
          if (sender) document.getElementById('prev-sender').textContent = sender.value;
          if (client) document.getElementById('prev-client').textContent = client.value;

          let total = 0;
          const tbody = document.getElementById('prev-tbody');
          if (tbody) {
            tbody.innerHTML = state.docItems.map(i => {
              total += i.rate;
              return `
                <tr>
                  <td style="padding: 0.5rem 0;">${i.desc}</td>
                  <td style="padding: 0.5rem 0; text-align: right; font-weight: 700;">${formatCurrency(i.rate)}</td>
                </tr>
              `;
            }).join('');
          }
          document.getElementById('prev-total').textContent = formatCurrency(total);
        }
      }

      document.querySelectorAll('#gen-form-box input').forEach(inp => inp.addEventListener('input', updatePreview));
      const addBtn = document.getElementById('add-item-btn');
      if (addBtn) {
        addBtn.addEventListener('click', () => {
          state.docItems.push({ desc: 'Additional Service Item', rate: 500 });
          renderItemsUI();
          updatePreview();
        });
      }

      renderItemsUI();
      updatePreview();

      const pdfBtn = document.getElementById('gen-pdf-btn');
      if (pdfBtn) {
        pdfBtn.addEventListener('click', () => {
          html2canvas(document.getElementById('a4-preview')).then(canvas => {
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF('p', 'mm', 'a4');
            pdf.addImage(canvas.toDataURL('image/png'), 'PNG', 10, 10, 190, 0);
            pdf.save(`${gen.slug}-document.pdf`);
          });
        });
      }
    }

