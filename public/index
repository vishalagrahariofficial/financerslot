    function handleContactSubmit() {
      const name = (document.getElementById('contact-name')?.value || '').trim();
      const email = (document.getElementById('contact-email')?.value || '').trim();
      const msg = (document.getElementById('contact-msg')?.value || '').trim();

      if (!msg) {
        alert('Please enter a message before sending.');
        return;
      }

      const subject = encodeURIComponent(`FinancerSlot Contact: ${name || 'Inquiry'}`);
      const body = encodeURIComponent(`From: ${name || 'Anonymous'} (${email || 'No email provided'})\n\nMessage:\n${msg}`);
      const mailtoUrl = `mailto:support@financerslot.com?subject=${subject}&body=${body}`;

      window.location.href = mailtoUrl;
      showToast('Opening default email application...');
    }

    /* ==========================================================================
       POPULAR TOOLS GRID RENDER & SEARCH
       ========================================================================== */
    function renderPopularTools(categoryFilter = 'all', searchQuery = '') {
      const grid = document.getElementById('popular-tools-grid');
      if (!grid) return;

      let filtered = TOOLS_DATA;
      if (categoryFilter !== 'all') filtered = filtered.filter(t => t.category === categoryFilter);
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        filtered = filtered.filter(t => t.title.toLowerCase().includes(q) || t.desc.toLowerCase().includes(q));
      }

      grid.innerHTML = filtered.slice(0, 18).map(t => `
        <a href="/tool/${t.slug}" class="tool-row">
          <div>
            <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted);">${t.category}</div>
            <div style="font-weight: 800; font-size: 1rem; color: var(--text-main); margin-top: 2px;">${t.title}</div>
            <div style="font-size: 0.8125rem; color: var(--text-muted);">${t.desc}</div>
          </div>
          <span style="font-weight: 800; color: var(--accent-primary); font-size: 1.125rem; margin-left: 0.5rem;">→</span>
        </a>
      `).join('');
    }

    function filterTab(category, btnEl) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btnEl.classList.add('active');
      const input = document.getElementById('hero-search-input');
      renderPopularTools(category, input ? input.value.trim() : '');
    }

    function setupSearchEngine(inputId, dropdownId) {
      const input = document.getElementById(inputId);
      const dropdown = document.getElementById(dropdownId);
      if (!input || !dropdown) return;

      input.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        renderPopularTools('all', q);
        if (!q) return dropdown.classList.remove('open');
        const matches = TOOLS_DATA.filter(t => t.title.toLowerCase().includes(q) || t.category.toLowerCase().includes(q)).slice(0, 7);
        dropdown.innerHTML = matches.map(m => `
          <a href="/tool/${m.slug}" class="search-result-item" onclick="document.getElementById('${dropdownId}').classList.remove('open');">
            <div>
              <strong>${m.title}</strong>
              <div style="font-size: 0.75rem; color: var(--text-muted);">${m.category}</div>
            </div>
            <span style="font-size: 0.75rem; font-weight: 800; color: var(--accent-primary);">Calculate →</span>
          </a>
        `).join('');
        dropdown.classList.add('open');
      });
    }

    function animateCountUp() {
      document.querySelectorAll('.count-up').forEach(el => {
        const target = parseFloat(el.getAttribute('data-target')) || 0;
        const decimals = parseInt(el.getAttribute('data-decimals')) || 0;
        const curr = currencyData[state.currency];
        const converted = target * curr.rate;
        el.textContent = new Intl.NumberFormat(curr.locale, { maximumFractionDigits: decimals, minimumFractionDigits: decimals }).format(converted);
      });
    }

    function toggleFaq(buttonEl) {
      const faqItem = buttonEl.parentElement;
      const isOpen = faqItem.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('open'));
      if (!isOpen) faqItem.classList.add('open');
    }

    const mobileDrawer = document.getElementById('mobile-drawer');
    document.getElementById('hamburger-btn').addEventListener('click', () => mobileDrawer.classList.add('open'));
    document.getElementById('close-drawer-btn').addEventListener('click', closeDrawer);
    function closeDrawer() { mobileDrawer.classList.remove('open'); }

    /* INITIALIZATION */
    function initApp() {
      applyTheme(state.theme);
      router();
    }

    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }
